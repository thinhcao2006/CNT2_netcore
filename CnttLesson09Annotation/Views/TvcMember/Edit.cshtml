@model CnttLesson09Annotation.Models.TvcMemberRegister

@{
    ViewData["Title"] = "Sửa thông tin thành viên";
}

<h1>Sửa thông tin thành viên</h1>
<h4>TvcMemberRegister</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TvcMemberId" />

            <div class="form-group mb-2">
                <label asp-for="TvcUserName" class="control-label">Tên đăng nhập</label>
                <input asp-for="TvcUserName" class="form-control" />
                <span asp-validation-for="TvcUserName" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="TvcEmail" class="control-label"></label>
                <input asp-for="TvcEmail" class="form-control" />
                <span asp-validation-for="TvcEmail" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="TvcPhoneNumber" class="control-label"></label>
                <input asp-for="TvcPhoneNumber" class="form-control" />
                <span asp-validation-for="TvcPhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="TvcFullName" class="control-label"></label>
                <input asp-for="TvcFullName" class="form-control" />
                <span asp-validation-for="TvcFullName" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="TvcBirthday" class="control-label"></label>
                <input asp-for="TvcBirthday" class="form-control" />
                <span asp-validation-for="TvcBirthday" class="text-danger"></span>
            </div>

            <div class="form-group mb-2">
                <label asp-for="TvcRole" class="control-label">Vai trò</label>
                <select asp-for="TvcRole" class="form-control">
                    <option value="Member">Member</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Lưu thay đổi" class="btn btn-warning" />
                <a asp-action="Index" class="ms-2">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
