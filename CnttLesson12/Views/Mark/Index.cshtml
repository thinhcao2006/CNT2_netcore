@model IEnumerable<CnttLesson12.Models.Mark>

@{
    ViewData["Title"] = "Bảng điểm";
    int index = 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><i class="bi bi-card-checklist text-primary"></i> Quản lý Bảng điểm</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nhập điểm mới
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="text-center" style="width: 60px;">#</th>
                    <th>Sinh viên</th>
                    <th>Môn học</th>
                    <th class="text-center">Điểm số</th>
                    <th class="text-center">Xếp loại</th>
                    <th class="text-center" style="width: 220px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center text-muted">@(index++)</td>
                            <td>
                                <strong>@item.Student?.StudentName</strong>
                                <br />
                                <small class="text-muted">@item.Student?.StudentEmail</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.Subject?.SubjectName</span>
                            </td>
                            <td class="text-center">
                                @{
                                    var scoreClass = item.Score >= 8 ? "badge bg-success fs-6" :
                                                    item.Score >= 6.5 ? "badge bg-info text-dark fs-6" :
                                                    item.Score >= 5 ? "badge bg-warning text-dark fs-6" : "badge bg-danger fs-6";
                                    var grade = item.Score >= 8 ? "Giỏi" :
                                                item.Score >= 6.5 ? "Khá" :
                                                item.Score >= 5 ? "Trung bình" : "Yếu / Thi lại";
                                }
                                <span class="@scoreClass">@item.Score.ToString("0.0")</span>
                            </td>
                            <td class="text-center">
                                <span>@grade</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId" class="btn btn-sm btn-outline-warning">
                                    Sửa
                                </a>
                                <a asp-action="Details" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId" class="btn btn-sm btn-outline-info">
                                    Chi tiết
                                </a>
                                <a asp-action="Delete" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId" class="btn btn-sm btn-outline-danger">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có dữ liệu điểm nào</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
