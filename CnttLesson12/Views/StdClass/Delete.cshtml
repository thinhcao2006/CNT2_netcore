@model CnttLesson12.Models.StdClass

@{
    ViewData["Title"] = "Xóa lớp học";
}

<h1>Xóa lớp học</h1>

<div class="alert alert-danger">Bạn có chắc muốn xóa lớp này không?</div>

<dl class="row" style="max-width:400px;">
    <dt class="col-sm-4">Tên lớp</dt>
    <dd class="col-sm-8">@Model.ClassName</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
