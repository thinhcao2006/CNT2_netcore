@model CnttLesson12.Models.Product

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<h1>Xóa sản phẩm</h1>

<div class="alert alert-danger">
    Bạn có chắc chắn muốn xóa sản phẩm này không?
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <img src="@Model.Image" alt="@Model.Name" style="max-width:120px;" class="mb-2" />
        }
        <dl class="row">
            <dt class="col-sm-4">Tên sản phẩm</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Giá</dt>
            <dd class="col-sm-8">@Model.Price.ToString("N0") đ</dd>

            <dt class="col-sm-4">Danh mục</dt>
            <dd class="col-sm-8">@Model.Category?.Name</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
