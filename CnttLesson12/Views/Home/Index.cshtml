@model IEnumerable<CnttLesson12.Models.Product>

@{
    ViewData["Title"] = "Trang chủ";
}

@* BÀI 4: Thay banner Microsoft Azure bằng banner dự án StudentManager *@
<div class="p-4 mb-4 bg-primary text-white rounded-3 text-center">
    <h1 class="display-5 fw-bold">🎓 Student Manager</h1>
    <p class="fs-5">Hệ thống quản lý sinh viên - ASP.NET Core MVC với Entity Framework</p>
    <div class="mt-3">
        <a asp-controller="Category" asp-action="Index" class="btn btn-light me-2">📂 Danh mục</a>
        <a asp-controller="Product" asp-action="Index" class="btn btn-light me-2">🛍️ Sản phẩm</a>
        <a asp-controller="StdClass" asp-action="Index" class="btn btn-light me-2">🏫 Lớp học</a>
        <a asp-controller="Student" asp-action="Index" class="btn btn-light me-2">👤 Sinh viên</a>
        <a asp-controller="Subject" asp-action="Index" class="btn btn-light me-2">📚 Môn học</a>
        <a asp-controller="Mark" asp-action="Index" class="btn btn-light">📊 Bảng điểm</a>
    </div>
</div>

@* BÀI 3: Danh sách sản phẩm với ảnh *@
<h3 class="mb-3">Danh sách sản phẩm</h3>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Chưa có sản phẩm nào.
        <a asp-controller="Product" asp-action="Create">Thêm sản phẩm</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="@item.Image" class="card-img-top" alt="@item.Name"
                             style="height:200px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center"
                             style="height:200px;font-size:60px;">🛍️</div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted small">@item.Category?.Name</p>
                        <p class="card-text fw-bold text-danger">@item.Price.ToString("N0") đ</p>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-info flex-fill">Chi tiết</a>
                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-warning flex-fill">Sửa</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
