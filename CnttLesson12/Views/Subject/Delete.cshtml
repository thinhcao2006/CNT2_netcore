@model CnttLesson12.Models.Subject

@{
    ViewData["Title"] = "Xóa môn học";
}

<h1>Xóa môn học</h1>

<div class="alert alert-danger">Bạn có chắc muốn xóa môn học này không?</div>

<dl class="row" style="max-width:400px;">
    <dt class="col-sm-4">Tên môn học</dt>
    <dd class="col-sm-8">@Model.SubjectName</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
