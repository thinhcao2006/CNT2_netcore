@model IEnumerable<CnttLesson12.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h1>Danh sách sinh viên</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Thêm sinh viên</a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Ảnh</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Điện thoại</th>
            <th>Lớp</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.StudentAvatar))
                    {
                        <img src="@item.StudentAvatar" style="width:50px;height:50px;border-radius:50%;object-fit:cover;" />
                    }
                    else
                    {
                        <span class="badge bg-secondary">N/A</span>
                    }
                </td>
                <td>@item.StudentName</td>
                <td>@item.StudentEmail</td>
                <td>@item.StudentPhone</td>
                <td>@item.StdClass?.ClassName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
