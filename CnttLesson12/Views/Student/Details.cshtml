@model CnttLesson12.Models.Student

@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<h1>Chi tiết sinh viên</h1>

<div class="row">
    <div class="col-md-3 text-center">
        @if (!string.IsNullOrEmpty(Model.StudentAvatar))
        {
            <img src="@Model.StudentAvatar" style="width:120px;height:120px;border-radius:50%;object-fit:cover;" />
        }
        else
        {
            <div style="width:120px;height:120px;border-radius:50%;background:#dee2e6;display:flex;align-items:center;justify-content:center;font-size:48px;">👤</div>
        }
    </div>
    <div class="col-md-9">
        <dl class="row">
            <dt class="col-sm-4">Họ tên</dt>
            <dd class="col-sm-8">@Model.StudentName</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.StudentEmail</dd>

            <dt class="col-sm-4">Điện thoại</dt>
            <dd class="col-sm-8">@Model.StudentPhone</dd>

            <dt class="col-sm-4">Địa chỉ</dt>
            <dd class="col-sm-8">@Model.StudentAddress</dd>

            <dt class="col-sm-4">Ngày sinh</dt>
            <dd class="col-sm-8">@Model.StudentBirthday.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Lớp</dt>
            <dd class="col-sm-8">@Model.StdClass?.ClassName</dd>
        </dl>
    </div>
</div>

@if (Model.Marks != null && Model.Marks.Any())
{
    <h5 class="mt-4">Bảng điểm</h5>
    <table class="table table-bordered" style="max-width:500px;">
        <thead class="table-secondary">
            <tr><th>Môn học</th><th>Điểm</th></tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Marks)
            {
                <tr>
                    <td>@m.Subject?.SubjectName</td>
                    <td>@m.Score</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Chỉnh sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>
