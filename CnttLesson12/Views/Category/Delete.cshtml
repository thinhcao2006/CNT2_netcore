@model CnttLesson12.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<h1>Xóa danh mục</h1>

<div class="alert alert-danger">
    Bạn có chắc chắn muốn xóa danh mục này không?
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Tên danh mục</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Trạng thái</dt>
            <dd class="col-sm-8">@Model.Status</dd>

            <dt class="col-sm-4">Ngày tạo</dt>
            <dd class="col-sm-8">@Model.CreatedDate.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
