@model List<CnttLesson04Lab.Models.Product>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="row mt-3">
    <!-- Sidebar danh mục bên trái -->
    <div class="col-md-3 mb-4">
        <div class="card">
            <div class="card-header bg-dark text-white font-weight-bold">
                DANH MỤC
            </div>
            <div class="list-group list-group-flush">
                <a href="@Url.RouteUrl("product_index")" class="list-group-item list-group-item-action @(ViewBag.SelectedCategoryId == null ? "active bg-success border-success text-white" : "")">
                    Tất cả sản phẩm
                </a>
                @if (ViewBag.Categories is List<CnttLesson04Lab.Models.Category> categoriesList)
                {
                    @foreach (var cat in categoriesList)
                    {
                        <a href="@Url.RouteUrl("product_index", new { cid = cat.Id })" class="list-group-item list-group-item-action @(ViewBag.SelectedCategoryId == cat.Id ? "active bg-success border-success text-white" : "")">
                            @cat.Name
                        </a>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Danh sách sản phẩm bên phải -->
    <div class="col-md-9">
        <h3 class="mb-3">Danh sách sản phẩm</h3>
        <hr />
        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-warning">
                Không tìm thấy sản phẩm nào thuộc danh mục này.
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-md-4 mb-4 d-flex align-items-stretch">
                        <div class="card w-100 p-2" style="border: 1px solid #ddd; border-radius: 4px; display: flex; flex-direction: column;">
                            <img src="@item.Image" class="card-img-top" alt="@item.Name" style="width: 100%; height: 250px; object-fit: cover;">
                            <div class="card-body d-flex flex-column justify-content-between p-2">
                                <div>
                                    <h5 class="card-title font-weight-bold" style="font-size: 1rem; min-height: 48px; margin-top: 10px;">@item.Name</h5>
                                    <p class="card-text text-muted mb-3" style="font-size: 0.95rem;">
                                        Giá: <del class="text-danger">@item.Price.ToString("0")</del> Giá mới <span class="text-success font-weight-bold">@item.SalePrice.ToString("0")</span>
                                    </p>
                                </div>
                                <div>
                                    <a asp-route="product_details" asp-route-id="@item.Id" class="btn btn-success w-100">Chi tiết</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
