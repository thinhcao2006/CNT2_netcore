@{
    ViewData["Title"] = "Trang quản trị hệ thống";
    Layout = "_CnttAdminLayout";
}

<div class="container-fluid p-0">
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small fw-semibold text-uppercase">Tổng sản phẩm</p>
                        <h3 class="fw-bold mb-0 text-primary">128</h3>
                    </div>
                    <div class="fs-1 text-primary opacity-50">📦</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small fw-semibold text-uppercase">Đơn hàng mới</p>
                        <h3 class="fw-bold mb-0 text-success">42</h3>
                    </div>
                    <div class="fs-1 text-success opacity-50">🛒</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small fw-semibold text-uppercase">Doanh thu tháng</p>
                        <h3 class="fw-bold mb-0 text-danger">350.8 Tr</h3>
                    </div>
                    <div class="fs-1 text-danger opacity-50">💰</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 bg-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-1 small fw-semibold text-uppercase">Lượt truy cập</p>
                        <h3 class="fw-bold mb-0 text-info">15.2K</h3>
                    </div>
                    <div class="fs-1 text-info opacity-50">👥</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold text-dark mb-0">Danh sách quản lý sản phẩm gần đây</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Tồn kho</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>#SP001</strong></td>
                        <td>Laptop Dell XPS 15</td>
                        <td>Máy tính xách tay</td>
                        <td class="text-danger fw-bold">32.990.000 đ</td>
                        <td>15</td>
                        <td><span class="badge bg-success">Đang bán</span></td>
                    </tr>
                    <tr>
                        <td><strong>#SP002</strong></td>
                        <td>iPhone 15 Pro Max</td>
                        <td>Điện thoại</td>
                        <td class="text-danger fw-bold">29.490.000 đ</td>
                        <td>8</td>
                        <td><span class="badge bg-success">Đang bán</span></td>
                    </tr>
                    <tr>
                        <td><strong>#SP003</strong></td>
                        <td>Tai nghe Sony WH-1000XM5</td>
                        <td>Phụ kiện âm thanh</td>
                        <td class="text-danger fw-bold">7.990.000 đ</td>
                        <td>24</td>
                        <td><span class="badge bg-success">Đang bán</span></td>
                    </tr>
                    <tr>
                        <td><strong>#SP004</strong></td>
                        <td>PC Gaming RTX 4080</td>
                        <td>Máy tính để bàn</td>
                        <td class="text-danger fw-bold">45.500.000 đ</td>
                        <td>3</td>
                        <td><span class="badge bg-warning text-dark">Sắp hết hàng</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
