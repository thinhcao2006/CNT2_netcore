@{
    ViewData["Title"] = "Danh sách sản phẩm";
    Layout = "~/Views/Shared/_CnttLayoutProduct.cshtml";
}

<div class="product-page">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h2 class="text-primary fw-bold mb-0">@ViewData["Title"]</h2>
        <span class="badge bg-success fs-6">Layout: _CnttLayoutProduct.cshtml</span>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=500&auto=format&fit=crop&q=60" class="card-img-top" alt="Laptop Pro" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <span class="badge bg-primary mb-2">Công nghệ</span>
                    <h5 class="card-title fw-bold">Laptop Dell XPS 15</h5>
                    <p class="card-text text-muted">Hiệu năng mạnh mẽ với chip Intel Core i7 thế hệ mới, màn hình OLED 4K siêu sắc nét.</p>
                </div>
                <div class="card-footer bg-transparent d-flex justify-content-between align-items-center border-0 pt-0">
                    <span class="text-danger fw-bold fs-5">32.990.000 đ</span>
                    <button class="btn btn-outline-primary btn-sm">Xem chi tiết</button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02560?w=500&auto=format&fit=crop&q=60" class="card-img-top" alt="Smartphone" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <span class="badge bg-info mb-2">Điện thoại</span>
                    <h5 class="card-title fw-bold">iPhone 15 Pro Max</h5>
                    <p class="card-text text-muted">Thiết kế khung titan sang trọng, camera zoom quang học 5x, chip A17 Pro đỉnh cao.</p>
                </div>
                <div class="card-footer bg-transparent d-flex justify-content-between align-items-center border-0 pt-0">
                    <span class="text-danger fw-bold fs-5">29.490.000 đ</span>
                    <button class="btn btn-outline-primary btn-sm">Xem chi tiết</button>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&auto=format&fit=crop&q=60" class="card-img-top" alt="Headphone" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <span class="badge bg-warning text-dark mb-2">Phụ kiện</span>
                    <h5 class="card-title fw-bold">Tai nghe Sony WH-1000XM5</h5>
                    <p class="card-text text-muted">Chống ồn chủ động hàng đầu ngành, âm thanh Hi-Res chân thực, thời lượng pin 30h.</p>
                </div>
                <div class="card-footer bg-transparent d-flex justify-content-between align-items-center border-0 pt-0">
                    <span class="text-danger fw-bold fs-5">7.990.000 đ</span>
                    <button class="btn btn-outline-primary btn-sm">Xem chi tiết</button>
                </div>
            </div>
        </div>
    </div>
</div>
