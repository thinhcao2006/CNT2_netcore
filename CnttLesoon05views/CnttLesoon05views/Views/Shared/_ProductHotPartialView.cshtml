@* Partial View: _ProductHotPartialView.cshtml (Slide 21) *@
@model IEnumerable<CnttLesoon05views.Models.Product>

<div class="border border-danger rounded p-3 bg-white shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h4 class="text-danger fw-bold mb-0">🔥 SẢN PHẨM HOT (PartialView Data Model)</h4>
        <span class="badge bg-danger">Ajax Loaded</span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-3">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-danger shadow-sm">
                        <div class="card-body">
                            <span class="badge bg-warning text-dark float-end">HOT 🔥</span>
                            <h5 class="card-title text-primary fw-bold">@item.Name</h5>
                            <p class="card-text text-muted small mb-2">@item.Description</p>
                            <p class="badge bg-secondary mb-2">Danh mục: @item.Category</p>
                        </div>
                        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold text-danger">@item.Price.ToString("N0") VNĐ</span>
                            <button class="btn btn-sm btn-outline-danger">Mua ngay</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning mb-0">Không có sản phẩm HOT nào được tìm thấy.</div>
    }
</div>
