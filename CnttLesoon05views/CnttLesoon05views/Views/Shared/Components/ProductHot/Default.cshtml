@* Slide 22 & 23: Razor View của View Component đặt tại Views/Shared/Components/ProductHot/Default.cshtml *@
@model IEnumerable<CnttLesoon05views.Models.Product>

<div class="card border-primary mb-3 shadow">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">⚡ ViewComponent: Top Sản Phẩm Nổi Bật</h5>
        <span class="badge bg-warning text-dark">Lớp ViewComponent riêng biệt</span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            <em>Nội dung này được render bởi <code>@@await Component.InvokeAsync("ProductHot", new { limit = ... })</code> độc lập với Controller.</em>
        </p>
        <div class="table-responsive">
            <table class="table table-hover align-middle table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Mã SP</th>
                        <th>Tên Sản Phẩm</th>
                        <th>Danh Mục</th>
                        <th>Mô tả cấu hình</th>
                        <th>Giá bán</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">#@item.Id</span></td>
                            <td class="fw-bold text-primary">@item.Name</td>
                            <td><span class="badge bg-info text-dark">@item.Category</span></td>
                            <td class="small">@item.Description</td>
                            <td class="fw-bold text-danger">@item.Price.ToString("N0") VNĐ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
