@model IEnumerable<CnttLesson07Models.Models.CnttMember>
@{
    ViewData["Title"] = "Danh sách thành viên (List of Models)";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-people-fill"></i> Danh sách thành viên (Members List)
            </h2>
            <p class="text-secondary mb-0">Theo Slide 5 &amp; Slide 15 - Session 04: Minh họa truyền <code>IEnumerable&lt;Member&gt;</code> sang View</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Thêm thành viên mới
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                <i class="bi bi-person-bounding-box me-1"></i> Xem Model đơn (Index)
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-dark">
                Tổng số thành viên: <span class="badge bg-primary rounded-pill">@(Model?.Count() ?? 0)</span>
            </span>
            <span class="text-muted small">Cú pháp View: <code>&#64;model IEnumerable&lt;CnttMember&gt;</code></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th scope="col" class="text-center" style="width: 80px;">STT</th>
                            <th scope="col">Mã thành viên</th>
                            <th scope="col">Tên đăng nhập</th>
                            <th scope="col">Họ và tên</th>
                            <th scope="col">Email</th>
                            <th scope="col" class="text-center" style="width: 260px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center fw-bold text-secondary">@(index++)</td>
                                    <td>
                                        <span class="badge bg-light text-primary border font-monospace px-2 py-1">
                                            @item.MemberId
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-medium text-dark">@item.Username</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-weight: bold; font-size: 0.85rem;">
                                                @(string.IsNullOrEmpty(item.Fullname) ? "M" : item.Fullname.Substring(0, 1).ToUpper())
                                            </div>
                                            <span class="fw-semibold text-dark">@item.Fullname</span>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="mailto:@item.Email" class="text-decoration-none">
                                            <i class="bi bi-envelope me-1 text-muted"></i>@item.Email
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.MemberId" class="btn btn-outline-info" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i> Chi tiết
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.MemberId" class="btn btn-outline-warning" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.MemberId" class="btn btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary"></i>
                                    Chưa có thành viên nào trong danh sách.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
