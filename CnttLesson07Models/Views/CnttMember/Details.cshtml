@model CnttLesson07Models.Models.CnttMember

@{
    ViewData["Title"] = "Chi tiết";
}

<div class="container mt-4">
    <h2>Thông tin chi tiết thành viên</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">CnttMemberId</dt>
        <dd class="col-sm-9">@Model.CnttMemberId</dd>

        <dt class="col-sm-3">CnttUserName</dt>
        <dd class="col-sm-9">@Model.CnttUserName</dd>

        <dt class="col-sm-3">CnttPassword</dt>
        <dd class="col-sm-9">@Model.CnttPassword</dd>

        <dt class="col-sm-3">CnttFullName</dt>
        <dd class="col-sm-9">@Model.CnttFullName</dd>

        <dt class="col-sm-3">CnttEmail</dt>
        <dd class="col-sm-9">@Model.CnttEmail</dd>
    </dl>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.CnttMemberId" class="btn btn-primary">Chỉnh sửa</a>
        <a asp-action="ListMember" class="btn btn-secondary ms-2">Quay lại danh sách</a>
    </div>
</div>
