@model CnttLesson08Model.Models.CnttDataModels.CnttMember

@{
    ViewData["Title"] = "Thông tin sinh viên";
}

<div class="container mt-4">
    <div class="card shadow-sm border p-4 bg-white rounded-2">
        <h1 class="display-6 fw-normal mb-3 text-dark">Thông tin sinh viên</h1>
        <hr />
        
        <div class="row">
            <div class="col-md-8">
                <dl class="row mb-4">
                    <dt class="col-sm-3 text-secondary">Member Id:</dt>
                    <dd class="col-sm-9 fw-medium text-dark">@Model?.CnttMemberId</dd>

                    <dt class="col-sm-3 text-secondary">Username:</dt>
                    <dd class="col-sm-9 text-dark">@Model?.CnttUserName</dd>

                    <dt class="col-sm-3 text-secondary">Password:</dt>
                    <dd class="col-sm-9 text-dark">@Model?.CnttPassword</dd>

                    <dt class="col-sm-3 text-secondary">Fullname:</dt>
                    <dd class="col-sm-9 text-dark">@Model?.CnttFullName</dd>

                    <dt class="col-sm-3 text-secondary">Email:</dt>
                    <dd class="col-sm-9 text-dark">@Model?.CnttEmail</dd>
                </dl>

                <div>
                    <a asp-action="Index" class="btn btn-primary me-2">Xem danh sách sinh viên</a>
                    <a asp-action="Create" class="btn btn-outline-success">Thêm mới sinh viên</a>
                </div>
            </div>
        </div>
    </div>
</div>
