@{
    ViewData["Title"] = "Liên hệ";
    Layout = "my_layout";
}

<div class="section-block">
    <div class="section-header">
        <i class="bi bi-telephone-fill"></i> Liên hệ với chúng tôi
    </div>
    <div class="section-body">
        <div class="row">
            <div class="col-md-6">
                <h5><i class="bi bi-geo-alt-fill text-danger me-2"></i>Địa chỉ</h5>
                <p>01 Võ Văn Ngân, Linh Chiểu, Thủ Đức, TP. HCM</p>
                <h5><i class="bi bi-envelope-fill text-primary me-2"></i>Email</h5>
                <p>contact@devmaster.edu.vn</p>
                <h5><i class="bi bi-phone-fill text-success me-2"></i>Điện thoại</h5>
                <p>0123 456 789</p>
            </div>
            <div class="col-md-6">
                <form>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ tên</label>
                        <input type="text" class="form-control" placeholder="Nhập họ tên" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" class="form-control" placeholder="Nhập email" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nội dung</label>
                        <textarea class="form-control" rows="4" placeholder="Nhập nội dung liên hệ..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-send me-1"></i>Gửi</button>
                </form>
            </div>
        </div>
    </div>
</div>
