@* Partial View: Banner quảng cáo *@

<div class="banner-partial">
    <div class="banner-icon">
        <i class="bi bi-gift-fill"></i>
    </div>
    <div class="banner-text">
        <h3>🔥 Khuyến mãi đặc biệt!</h3>
        <p>Giảm giá đến 50% toàn bộ sách trong tuần này. Mua ngay hôm nay để nhận ưu đãi hấp dẫn nhất!</p>
        <a asp-controller="Book" asp-action="Index" class="btn-banner">
            <i class="bi bi-bag-check-fill"></i>Mua ngay
        </a>
    </div>
    <div style="margin-left:auto; text-align:center; position:relative; z-index:1;">
        <div style="font-size:52px; margin-bottom:4px;">📚</div>
        <div style="font-size:26px; font-weight:900; color:#fbbf24; text-shadow:0 2px 4px rgba(0,0,0,0.2);">-50%</div>
    </div>
</div>
