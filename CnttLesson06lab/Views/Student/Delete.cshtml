@model CnttLesson06lab.Models.Student
@{
    ViewData["Title"] = "Xóa Sinh viên";
}

<div class="page-header">
    <h1 class="page-title">
        <i class="bi bi-trash-fill me-2 text-danger"></i>Xóa Sinh viên
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Student" asp-action="Index">Danh sách sinh viên</a></li>
            <li class="breadcrumb-item active">Xóa - @Model.FullName</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa</h5>
            </div>
            <div class="card-body p-4 text-center">
                <div class="rounded-circle d-flex align-items-center justify-content-center bg-danger text-white mx-auto mb-3"
                     style="width:80px;height:80px;font-size:2rem;font-weight:bold;">
                    @Model.FullName[0]
                </div>
                <h4 class="mb-1">@Model.FullName</h4>
                <span class="badge bg-secondary me-1">Mã SV: #@Model.StudentId</span>
                <span class="badge bg-info text-dark">@Model.ClassName</span>

                <div class="alert alert-warning mt-4 text-start" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    <strong>Cảnh báo:</strong> Hành động này <strong>không thể hoàn tác</strong>.
                    Toàn bộ thông tin của sinh viên này sẽ bị xóa vĩnh viễn.
                </div>

                <div class="row g-2 text-start small text-muted border rounded p-3 mb-4">
                    <div class="col-6"><i class="bi bi-envelope me-1"></i> @Model.Email</div>
                    <div class="col-6"><i class="bi bi-telephone me-1"></i> @Model.Phone</div>
                    <div class="col-6"><i class="bi bi-calendar me-1"></i> @Model.DateOfBirth.ToString("dd/MM/yyyy")</div>
                    <div class="col-6"><i class="bi bi-award me-1"></i> GPA: @Model.GPA.ToString("F1")</div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="StudentId" />
                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-action="Details" asp-route-id="@Model.StudentId" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i>Hủy
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i>Xác nhận Xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
