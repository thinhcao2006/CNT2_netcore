@model List<CnttLesson06lab.Models.Student>
@{
    ViewData["Title"] = "Danh sách Sinh viên";
    var totalStudents = Model.Count;
    var avgGpa = totalStudents > 0 ? Model.Average(s => s.GPA) : 0;
    var excellent = Model.Count(s => s.GPA >= 3.6);
    var good = Model.Count(s => s.GPA >= 3.2 && s.GPA < 3.6);
    var classes = Model.Select(s => s.ClassName).Distinct().OrderBy(c => c).ToList();
    string? filterClass = ViewBag.FilterClass as string;
    string? searchKeyword = ViewBag.SearchKeyword as string;
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="page-title">
                <i class="bi bi-mortarboard-fill me-2 text-primary"></i>Quản lý Sinh viên
            </h1>
            <p class="text-muted mb-0">Tổng số: <strong>@totalStudents</strong> sinh viên</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Thêm sinh viên
        </a>
    </div>
</div>

@* Thông báo *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Thống kê tổng quan *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0 bg-primary text-white">
            <div class="card-body py-3">
                <div class="fs-1 fw-bold">@totalStudents</div>
                <div class="small opacity-75">Tổng sinh viên</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0 bg-success text-white">
            <div class="card-body py-3">
                <div class="fs-1 fw-bold">@avgGpa.ToString("F2")</div>
                <div class="small opacity-75">GPA trung bình</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0 bg-warning text-dark">
            <div class="card-body py-3">
                <div class="fs-1 fw-bold">@excellent</div>
                <div class="small opacity-75">Xuất sắc (≥3.6)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm border-0 bg-info text-dark">
            <div class="card-body py-3">
                <div class="fs-1 fw-bold">@classes.Count</div>
                <div class="small opacity-75">Số lớp</div>
            </div>
        </div>
    </div>
</div>

@* Thanh tìm kiếm & lọc *@
<div class="card shadow-sm mb-4">
    <div class="card-body py-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="search" value="@searchKeyword"
                           class="form-control border-start-0 ps-0"
                           placeholder="Tìm theo tên, lớp, email, SĐT..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="filterClass" class="form-select">
                    <option value="">-- Tất cả lớp --</option>
                    @foreach (var cls in Model.Select(s => s.ClassName).Distinct().OrderBy(c => c).ToList())
                    {
                        if (cls == filterClass)
                        {
                            <option value="@cls" selected>@cls</option>
                        }
                        else
                        {
                            <option value="@cls">@cls</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                @if (!string.IsNullOrEmpty(searchKeyword) || !string.IsNullOrEmpty(filterClass))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted opacity-50"></i>
        <h4 class="mt-3 text-muted">Không tìm thấy sinh viên nào</h4>
        @if (!string.IsNullOrEmpty(searchKeyword) || !string.IsNullOrEmpty(filterClass))
        {
            <p class="text-muted">Thử tìm kiếm với từ khóa khác hoặc <a asp-action="Index">xem tất cả</a>.</p>
        }
        else
        {
            <a asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle me-2"></i>Thêm sinh viên đầu tiên
            </a>
        }
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3" style="width:60px">#</th>
                        <th>Họ và tên</th>
                        <th style="width:90px">Lớp</th>
                        <th style="width:110px">Ngày sinh</th>
                        <th>Email</th>
                        <th style="width:110px">SĐT</th>
                        <th class="text-center" style="width:100px">GPA</th>
                        <th class="text-center" style="width:90px">Giới tính</th>
                        <th class="text-center" style="width:110px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sv in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-muted">@sv.StudentId</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@sv.StudentId"
                                   class="text-decoration-none fw-semibold text-dark">
                                    <i class="bi bi-person-circle me-1 text-secondary"></i>@sv.FullName
                                </a>
                            </td>
                            <td><span class="badge bg-secondary rounded-pill">@sv.ClassName</span></td>
                            <td class="small text-muted">@sv.DateOfBirth.ToString("dd/MM/yyyy")</td>
                            <td class="text-muted small">@sv.Email</td>
                            <td class="text-muted small">@sv.Phone</td>
                            <td class="text-center">
                                @{
                                    string badgeClass = sv.GPA >= 3.6 ? "bg-success" :
                                                        sv.GPA >= 3.2 ? "bg-primary" :
                                                        sv.GPA >= 2.5 ? "bg-info text-dark" :
                                                        sv.GPA >= 2.0 ? "bg-warning text-dark" : "bg-danger";
                                }
                                <span class="badge @badgeClass px-2 py-1">
                                    @sv.GPA.ToString("F1")
                                </span>
                                <div class="small text-muted" style="font-size:0.7rem">@sv.GpaRank</div>
                            </td>
                            <td class="text-center">
                                @if (sv.Gender == "Nam")
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">
                                        <i class="bi bi-gender-male"></i> Nam
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">
                                        <i class="bi bi-gender-female"></i> Nữ
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@sv.StudentId"
                                       class="btn btn-outline-info" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@sv.StudentId"
                                       class="btn btn-outline-warning" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@sv.StudentId"
                                       class="btn btn-outline-danger" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small text-end">
            Hiển thị @Model.Count sinh viên
        </div>
    </div>
}
