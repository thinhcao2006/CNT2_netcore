@model CnttLesson06lab.Models.Book

@{
    ViewData["Title"] = "Chỉnh sửa Sách";
    Layout = "my_layout";
}

<div class="page-header">
    <h1 class="page-title">
        <i class="bi bi-pencil-square me-2 text-warning"></i>Chỉnh sửa Sách
    </h1>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Book" asp-action="Index">Danh sách sách</a></li>
            <li class="breadcrumb-item active">Sửa - @Model.Title</li>
        </ol>
    </nav>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-book-half me-2"></i>Cập nhật thông tin - Mã: <strong>#@Model.Id</strong>
                </h5>
            </div>
            <div class="card-body p-4">
                <form action="" method="POST" role="form">

                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-semibold">Tên sách</label>
                            <input type="text" class="form-control" asp-for="Title" placeholder="Tên sách" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AuthorId" class="form-label fw-semibold">Tác giả</label>
                            <select asp-for="AuthorId" class="form-select" asp-items="@ViewBag.authors">
                                <option value="">-- Chọn tác giả --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="GenreId" class="form-label fw-semibold">Thể loại</label>
                            <select asp-for="GenreId" class="form-select" asp-items="@ViewBag.genres">
                                <option value="">-- Chọn thể loại --</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">Giá sách (đ)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-currency-exchange"></i></span>
                                <input type="number" class="form-control" asp-for="Price" placeholder="Ví dụ: 150000" min="0" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TotalPage" class="form-label fw-semibold">Tổng số trang</label>
                            <input type="number" class="form-control" asp-for="TotalPage" placeholder="Ví dụ: 350" min="1" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Image" class="form-label fw-semibold">Đường dẫn hình ảnh</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-image"></i></span>
                                <input type="text" class="form-control" asp-for="Image" placeholder="/images/products/ten-anh.jpg" />
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <div class="mt-2">
                                    <img src="@Model.Image" alt="@Model.Title" class="img-thumbnail" style="max-height:100px;" />
                                </div>
                            }
                        </div>

                        <div class="col-12">
                            <label asp-for="Sumary" class="form-label fw-semibold">Giới thiệu ngắn</label>
                            <textarea class="form-control" asp-for="Sumary" rows="4"
                                      placeholder="Nội dung giới thiệu sách..."></textarea>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Hủy
                        </a>
                        <button type="submit" class="btn btn-warning px-4">
                            <i class="bi bi-save me-1"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
