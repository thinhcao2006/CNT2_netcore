@model IEnumerable<CnttLesson06lab.Models.Book>

@* PartialView - Sách phổ biến (Bài 3: được load qua Ajax) *@
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="overflow-hidden bg-light" style="height:180px;">
                    <img src="@item.Image" alt="@item.Title"
                         class="w-100 h-100" style="object-fit:cover;" />
                </div>
                <div class="card-body p-3">
                    <h6 class="card-title fw-bold mb-1 text-truncate">@item.Title</h6>
                    <p class="fw-semibold text-success mb-0">
                        @item.Price.ToString("N0") đ
                    </p>
                    <p class="text-muted small mb-0">@item.TotalPage trang</p>
                </div>
            </div>
        </div>
    }
</div>
