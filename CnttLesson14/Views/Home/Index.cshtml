@{
    ViewData["Title"] = "Trang chủ";
}

<div class="p-5 mb-4 bg-light rounded-3 text-center border">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold">ASP.NET Core MVC - Labguide 07</h1>
        <p class="fs-5 text-muted">Thực hành xây dựng Layout, Area và quản lý dữ liệu với Entity Framework Core</p>
        <a class="btn btn-primary btn-lg" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            Truy cập Trang Quản Trị (Admin Area)
        </a>
    </div>
</div>

<div class="row text-center mt-4">
    <div class="col-md-4 mb-3">
        <div class="card p-3 h-100 shadow-sm">
            <h4 class="fw-bold text-primary">Bài 1 & 2: Layout</h4>
            <p class="text-muted">Tìm hiểu _Layout, cấu hình _ViewStart, _ViewImports và tạo layout mới _main.cshtml.</p>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card p-3 h-100 shadow-sm">
            <h4 class="fw-bold text-success">Bài 3: Area Admin</h4>
            <p class="text-muted">Tạo vùng quản trị riêng biệt với Dashboard, Category và cấu hình Route Area.</p>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card p-3 h-100 shadow-sm">
            <h4 class="fw-bold text-warning">Bài Tự Làm: CRUD</h4>
            <p class="text-muted">Xây dựng ViewComponent NavLeft và các chức năng CRUD cho Category, Product, Banner, Blog.</p>
        </div>
    </div>
</div>
