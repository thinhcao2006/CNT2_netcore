@model CnttLesson08Lab.Models.CnttSinhVien

@{
    ViewData["Title"] = "Chi tiết sinh viên";
    string badgeClass = Model.XepLoai switch
    {
        "Xuất sắc" => "bg-success",
        "Giỏi" => "bg-primary",
        "Khá" => "bg-info",
        "Trung bình" => "bg-warning text-dark",
        _ => "bg-danger"
    };
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-person"></i> Chi tiết sinh viên #@Model.MaSV</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Mã sinh viên</dt>
                    <dd class="col-sm-8">@Model.MaSV</dd>

                    <dt class="col-sm-4">Họ tên</dt>
                    <dd class="col-sm-8"><strong>@Model.HoTen</strong></dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                    <dt class="col-sm-4">Số điện thoại</dt>
                    <dd class="col-sm-8">@Model.SoDienThoai</dd>

                    <dt class="col-sm-4">Lớp</dt>
                    <dd class="col-sm-8">@Model.Lop</dd>

                    <dt class="col-sm-4">Ngành học</dt>
                    <dd class="col-sm-8">@Model.Nganh</dd>

                    <dt class="col-sm-4">Ngày sinh</dt>
                    <dd class="col-sm-8">@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4">Địa chỉ</dt>
                    <dd class="col-sm-8">@(Model.DiaChi ?? "—")</dd>

                    <dt class="col-sm-4">Điểm trung bình</dt>
                    <dd class="col-sm-8"><strong class="fs-5">@Model.DiemTB.ToString("F1")</strong></dd>

                    <dt class="col-sm-4">Xếp loại</dt>
                    <dd class="col-sm-8"><span class="badge fs-6 @badgeClass">@Model.XepLoai</span></dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.MaSV" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Sửa
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
</div>
