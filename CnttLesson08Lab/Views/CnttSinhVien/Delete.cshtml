@model CnttLesson08Lab.Models.CnttSinhVien

@{
    ViewData["Title"] = "Xác nhận xóa sinh viên";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Xác nhận xóa sinh viên</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-circle"></i>
                    Bạn có chắc chắn muốn xóa sinh viên <strong>"@Model.HoTen"</strong> không?
                    Hành động này không thể hoàn tác!
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Mã sinh viên</dt>
                    <dd class="col-sm-8">@Model.MaSV</dd>

                    <dt class="col-sm-4">Họ tên</dt>
                    <dd class="col-sm-8"><strong>@Model.HoTen</strong></dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Lớp</dt>
                    <dd class="col-sm-8">@Model.Lop</dd>

                    <dt class="col-sm-4">Điểm TB</dt>
                    <dd class="col-sm-8">@Model.DiemTB.ToString("F1") - @Model.XepLoai</dd>
                </dl>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaSV" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xác nhận xóa
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
