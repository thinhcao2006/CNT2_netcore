@model IEnumerable<CnttLesson08Lab.Models.CnttSanPham>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-box-seam"></i> @ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm sản phẩm mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Mã SP</th>
                <th>Tên sản phẩm</th>
                <th>Loại SP</th>
                <th class="text-end">Đơn giá (VNĐ)</th>
                <th class="text-center">Số lượng</th>
                <th class="text-end">Thành tiền (VNĐ)</th>
                <th class="text-center">Ngày nhập</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        <i class="bi bi-inbox"></i> Chưa có sản phẩm nào
                    </td>
                </tr>
            }
            @foreach (var sp in Model)
            {
                <tr>
                    <td>@sp.MaSP</td>
                    <td><strong>@sp.TenSP</strong></td>
                    <td><span class="badge bg-info">@sp.LoaiSP</span></td>
                    <td class="text-end">@sp.DonGia.ToString("N0")</td>
                    <td class="text-center">@sp.SoLuong</td>
                    <td class="text-end fw-bold text-success">@sp.ThanhTien.ToString("N0")</td>
                    <td class="text-center">@sp.NgayNhap.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@sp.MaSP" class="btn btn-sm btn-outline-info" title="Chi tiết">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@sp.MaSP" class="btn btn-sm btn-outline-warning" title="Sửa">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@sp.MaSP" class="btn btn-sm btn-outline-danger" title="Xóa">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
        @if (Model.Any())
        {
            <tfoot class="table-secondary">
                <tr>
                    <td colspan="4" class="text-end fw-bold">Tổng thành tiền:</td>
                    <td></td>
                    <td class="text-end fw-bold text-danger">@Model.Sum(x => x.ThanhTien).ToString("N0")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        }
    </table>
</div>
