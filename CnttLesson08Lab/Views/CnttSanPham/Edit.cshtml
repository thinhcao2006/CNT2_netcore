@model CnttLesson08Lab.Models.CnttSanPham

@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-warning">
                <h4 class="mb-0"><i class="bi bi-pencil"></i> Chỉnh sửa sản phẩm #@Model.MaSP</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaSP" />

                    <div class="mb-3">
                        <label asp-for="TenSP" class="form-label fw-bold"></label>
                        <input asp-for="TenSP" class="form-control" />
                        <span asp-validation-for="TenSP" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LoaiSP" class="form-label fw-bold"></label>
                        <select asp-for="LoaiSP" class="form-select">
                            <option value="">-- Chọn loại sản phẩm --</option>
                            <option value="Điện tử">Điện tử</option>
                            <option value="Phụ kiện">Phụ kiện</option>
                            <option value="Văn phòng phẩm">Văn phòng phẩm</option>
                            <option value="Thực phẩm">Thực phẩm</option>
                            <option value="Thời trang">Thời trang</option>
                            <option value="Khác">Khác</option>
                        </select>
                        <span asp-validation-for="LoaiSP" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DonGia" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <input asp-for="DonGia" class="form-control" type="number" min="1000" step="1000" />
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            <span asp-validation-for="DonGia" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="SoLuong" class="form-label fw-bold"></label>
                            <input asp-for="SoLuong" class="form-control" type="number" min="0" />
                            <span asp-validation-for="SoLuong" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NgayNhap" class="form-label fw-bold"></label>
                        <input asp-for="NgayNhap" class="form-control" type="date" />
                        <span asp-validation-for="NgayNhap" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-bold"></label>
                        <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="MoTa" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Lưu thay đổi
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.MaSP" class="btn btn-info">
                            <i class="bi bi-eye"></i> Xem chi tiết
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
